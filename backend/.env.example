# CognoDB / Neo4j connection details.
# Copy this file to .env and fill in the values from your CognoDB Cloud instance.
# NEVER commit the real .env file.

# Connection URI from the CognoDB console, e.g. bolt+s://<instance-id>.databases.cognodb.cloud
NEO4J_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud

# Username (CognoDB default is "cognodb")
NEO4J_USER=cognodb

# The password shown once when the instance was created
NEO4J_PASSWORD=<your-password>

# Optional: database name (CognoDB/Neo4j default is "neo4j")
NEO4J_DATABASE=neo4j

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
